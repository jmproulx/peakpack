<Project Sdk="Microsoft.NET.Sdk">
  <!--
    PeakPack's in-game companion (BepInEx 5 plugin), shipped in every pack by the publisher ("companion": "auto").
      - lobby check: compares your pack revision with the lobby host's (Photon room/player custom properties)
        and tells you in PEAK's own connection feed when they differ;
      - live settings: whitelisted BepInEx config values follow the lobby host while you're in their lobby.
    Build:  dotnet build src\PeakPack.Companion -c Release      (needs PEAK installed; references are read-only)
    Not part of FriendInstaller.sln on purpose: it can only build where PEAK's DLLs exist.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PeakPack.Companion</AssemblyName>
    <RootNamespace>PeakPack.Companion</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.4.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- Embedded PDB: Hamunii AutoReload reads plugins with Mono.Cecil ReadSymbols=true. -->
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>

    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\PEAK</GameDir>
    <ManagedDir>$(GameDir)\PEAK_Data\Managed</ManagedDir>
    <!-- BepInEx.dll: the game's own BepInEx\core if present, else a PeakPack profile. Only the public BepInEx 5 API is used. -->
    <BepInExCore Condition="'$(BepInExCore)' == '' And Exists('$(GameDir)\BepInEx\core\BepInEx.dll')">$(GameDir)\BepInEx\core</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(LOCALAPPDATA)\PeakPack\profile\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCore)\BepInEx.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="PhotonUnityNetworking" HintPath="$(ManagedDir)\PhotonUnityNetworking.dll" Private="false" />
    <Reference Include="PhotonRealtime" HintPath="$(ManagedDir)\PhotonRealtime.dll" Private="false" />
    <Reference Include="Photon3Unity3D" HintPath="$(ManagedDir)\Photon3Unity3D.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.JSONSerializeModule" HintPath="$(ManagedDir)\UnityEngine.JSONSerializeModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(ManagedDir)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)\0Harmony.dll" Private="false" />
  </ItemGroup>

  <!-- After every build: fail if our IL touches non-public game members directly (use cached AccessTools instead). -->
  <Target Name="IlAccessCheck" AfterTargets="Build" Condition="'$(SkipIlScan)' != 'true'">
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; run --project &quot;$(MSBuildProjectDirectory)\..\..\tools\IlScan\IlScan.csproj&quot; -c Release -- &quot;$(TargetPath)&quot; &quot;$(ManagedDir)&quot; &quot;$(BepInExCore)&quot;" />
  </Target>
</Project>

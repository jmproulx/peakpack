<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PeakPack.Core\PeakPack.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PeakPack</AssemblyName>
    <RootNamespace>PeakPack.App</RootNamespace>
    <Version>0.4.1</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Company>PeakPack</Company>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>PeakPack</Product>
    <Description>One-click PEAK mods from your host</Description>
  </PropertyGroup>

  <!-- Friends get ONE exe that needs nothing else installed (no .NET runtime). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Joshua edits this once (manifest URL, public key) before building the copy he shares. -->
    <EmbeddedResource Include="pack.config.json" LogicalName="PeakPack.App.pack.config.json" />
    <EmbeddedResource Include="app-256.png" LogicalName="PeakPack.App.app-256.png" />
  </ItemGroup>

</Project>

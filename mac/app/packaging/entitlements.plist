<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime is on even for ad-hoc builds, so a Developer ID build later behaves the same.
	     Wine runs as our child process; macOS attributes PEAK's microphone use to this app. -->
	<key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>

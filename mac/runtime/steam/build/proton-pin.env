# Pinned source of Valve's lsteamclient (ValveSoftware/Proton). Sourced by
# fetch_lsteamclient.sh. Valve's sources are fetched at build time and are
# never committed to our repo or redistributed as source.
#
# Pin: release tag proton-11.0-2e (head of branch proton_11.0, committed
# 2026-10-09). Its lsteamclient/ tree is byte-identical to the one in commit
# 164e0ccd2ea2b1ec2e5d08dc97f65b184c2539ca (2026-09-11) that NotProton's macOS
# changes were measured against. It covers Steamworks SDK 0.99u .. 1.65,
# including every interface PEAK (SDK 1.61) asks for: SteamClient021,
# SteamUser023, SteamFriends017, SteamUtils010, SteamMatchMaking009,
# STEAMUSERSTATS_INTERFACE_VERSION013, ...
#
# Two checks, both recorded 2026-10-12:
#  - PROTON_TARBALL_SHA256: sha256 of the codeload.github.com tarball (it was
#    identical across two downloads). GitHub can regenerate archives, so a
#    mismatch alone is a warning unless PP_STRICT_TARBALL=1.
#  - LSTEAMCLIENT_TREE_SHA256: content digest of the extracted lsteamclient/
#    tree. This is the authoritative check and must always match. Formula:
#      (cd <extract root> && LC_ALL=C find lsteamclient -type f | LC_ALL=C sort |
#       while read f; do printf '%s  %s\n' "$(sha256 < "$f")" "$f"; done) | sha256
#    i.e. sha256 of a sha256sum-style manifest of every file, sorted by path.

PROTON_REPO=ValveSoftware/Proton
PROTON_TAG=proton-11.0-2e
PROTON_COMMIT=bc896217ffcd67f892f952b010f898fe7bd0f0a1
PROTON_TARBALL_URL=https://codeload.github.com/ValveSoftware/Proton/tar.gz/bc896217ffcd67f892f952b010f898fe7bd0f0a1
PROTON_TARBALL_SHA256=be18d77ae5f9e5ce21318d151c692648e5cb7c5ffa50dea2dcac6c408966b077
PROTON_TARBALL_BYTES=93595375
LSTEAMCLIENT_TREE_SHA256=bf5eb856225908d8885b6ba506122f26be3d68bb320f48199ffb3798b92ad987
LSTEAMCLIENT_FILE_COUNT=3133

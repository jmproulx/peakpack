/* Version resource for the PeakPack steamclient64.dll forwarder. */
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PeakPack project"
            VALUE "FileDescription", "PeakPack for Mac: forwards steamclient64 exports to Wine's lsteamclient.dll"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "steamclient64"
            VALUE "LegalCopyright", "Copyright (c) 2026 the PeakPack project, MIT licence"
            VALUE "OriginalFilename", "steamclient64.dll"
            VALUE "ProductName", "PeakPack for Mac"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

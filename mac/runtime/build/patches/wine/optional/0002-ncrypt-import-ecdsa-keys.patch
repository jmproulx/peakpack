+/* PeakPack: ECDSA P-256/P-384/P-521 public and private blobs, specific or generic ("ECDP"/"ECDV" plus an
+ * NCRYPTBUFFER_ECC_CURVE_NAME parameter, as .NET's ECDsa uses), imported through bcrypt's ECDSA providers.
+ * Verification then works through NCryptVerifySignature -> BCryptVerifySignature. */
+static SECURITY_STATUS import_ecdsa_key(NCRYPT_PROV_HANDLE provider, const WCHAR *curve, BYTE *data,
+                                        DWORD datasize, struct object **ret_object)
+{
+    BCRYPT_ECCKEY_BLOB *ecc = (BCRYPT_ECCKEY_BLOB *)data;
+    BCRYPT_ALG_HANDLE alg;
+    const WCHAR *alg_name, *curve_name;
+    BOOL private_blob;
+    struct object *object;
+    NTSTATUS status;
+    DWORD bits, sig_len;
+    BYTE *copy = NULL;
+
+    if (datasize < sizeof(*ecc)) return NTE_BAD_DATA;
+    private_blob = (ecc->dwMagic == BCRYPT_ECDSA_PRIVATE_P256_MAGIC || ecc->dwMagic == BCRYPT_ECDSA_PRIVATE_P384_MAGIC ||
+                    ecc->dwMagic == BCRYPT_ECDSA_PRIVATE_P521_MAGIC || ecc->dwMagic == BCRYPT_ECDSA_PRIVATE_GENERIC_MAGIC);
+
+    if (ecc->dwMagic == BCRYPT_ECDSA_PUBLIC_GENERIC_MAGIC || ecc->dwMagic == BCRYPT_ECDSA_PRIVATE_GENERIC_MAGIC)
+    {
+        if (!curve)
+        {
+            WARN("generic EC blob without a curve name\n");
+            return NTE_INVALID_PARAMETER;
+        }
+        if (!lstrcmpiW(curve, L"nistP256") || !lstrcmpiW(curve, L"secP256r1")) bits = 256;
+        else if (!lstrcmpiW(curve, L"nistP384") || !lstrcmpiW(curve, L"secP384r1")) bits = 384;
+        else if (!lstrcmpiW(curve, L"nistP521") || !lstrcmpiW(curve, L"secP521r1")) bits = 521;
+        else
+        {
+            FIXME("curve %s not supported\n", debugstr_w(curve));
+            return NTE_NOT_SUPPORTED;
+        }
+        if (!(copy = malloc(datasize))) return NTE_NO_MEMORY;
+        memcpy(copy, data, datasize);
+        ecc = (BCRYPT_ECCKEY_BLOB *)copy;
+        if (bits == 256) ecc->dwMagic = private_blob ? BCRYPT_ECDSA_PRIVATE_P256_MAGIC : BCRYPT_ECDSA_PUBLIC_P256_MAGIC;
+        else if (bits == 384) ecc->dwMagic = private_blob ? BCRYPT_ECDSA_PRIVATE_P384_MAGIC : BCRYPT_ECDSA_PUBLIC_P384_MAGIC;
+        else ecc->dwMagic = private_blob ? BCRYPT_ECDSA_PRIVATE_P521_MAGIC : BCRYPT_ECDSA_PUBLIC_P521_MAGIC;
+    }
+
+    switch (ecc->dwMagic)
+    {
+    case BCRYPT_ECDSA_PUBLIC_P256_MAGIC:
+    case BCRYPT_ECDSA_PRIVATE_P256_MAGIC:
+        alg = BCRYPT_ECDSA_P256_ALG_HANDLE; alg_name = BCRYPT_ECDSA_P256_ALGORITHM; curve_name = L"nistP256"; bits = 256;
+        break;
+    case BCRYPT_ECDSA_PUBLIC_P384_MAGIC:
+    case BCRYPT_ECDSA_PRIVATE_P384_MAGIC:
+        alg = BCRYPT_ECDSA_P384_ALG_HANDLE; alg_name = BCRYPT_ECDSA_P384_ALGORITHM; curve_name = L"nistP384"; bits = 384;
+        break;
+    default:
+        alg = BCRYPT_ECDSA_P521_ALG_HANDLE; alg_name = BCRYPT_ECDSA_P521_ALGORITHM; curve_name = L"nistP521"; bits = 521;
+        break;
+    }
+
+    if (!(object = create_key_object(ECDSA, provider)))
+    {
+        free(copy);
+        return NTE_NO_MEMORY;
+    }
+    status = BCryptImportKeyPair(alg, NULL, private_blob ? BCRYPT_ECCPRIVATE_BLOB : BCRYPT_ECCPUBLIC_BLOB,
+                                 &object->key.bcrypt_key, (BYTE *)ecc, datasize, 0);
+    free(copy);
+    if (status != STATUS_SUCCESS)
+    {
+        WARN("Error importing EC key %#lx\n", status);
+        free(object);
+        return map_ntstatus(status);
+    }
+
+    sig_len = 2 * ((bits + 7) / 8);
+    set_object_property(object, NCRYPT_ALGORITHM_PROPERTY, (BYTE *)alg_name, (lstrlenW(alg_name) + 1) * sizeof(WCHAR));
+    set_object_property(object, NCRYPT_LENGTH_PROPERTY, (BYTE *)&bits, sizeof(bits));
+    set_object_property(object, BCRYPT_PUBLIC_KEY_LENGTH, (BYTE *)&bits, sizeof(bits));
+    set_object_property(object, BCRYPT_SIGNATURE_LENGTH, (BYTE *)&sig_len, sizeof(sig_len));
+    set_object_property(object, L"ECCCurveName", (BYTE *)curve_name, (lstrlenW(curve_name) + 1) * sizeof(WCHAR));
+    *ret_object = object;
+    return ERROR_SUCCESS;
+}

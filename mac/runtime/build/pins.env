# shellcheck shell=bash disable=SC2034
# PeakPack for Mac: every build input, pinned by URL + SHA-256 (or by git commit SHA).
# Values starting with FILL are placeholders. A normal build refuses them; a
# first-download run (PP_ALLOW_UNPINNED=1) prints the observed hash into
# $PP_WORK/UNPINNED.txt so it can be reviewed and copied here. Release builds
# (workflow input publish=true) refuse PP_ALLOW_UNPINNED.
#
# Provenance of each hash is in the comment above it. "verified-local" = hashed on
# Joshua's PC from a copy we hold; "gh-digest" = GitHub release-asset digest
# (api.github.com ... assets[].digest); "third-party" = copied from another
# project's pin and must be re-checked on first download.

# ---- Our revision -----------------------------------------------------------
PP_REVISION=1                 # bump on any change below or to patches/flags
PP_MACOS_MIN=14.0             # DXMT needs macOS 14 Sonoma; deps built for 14.0
PP_PE_TOOLCHAIN=llvm-mingw    # llvm-mingw | mingw-gcc (see DECISIONS.md D4)

# ---- CrossOver LGPL sources (Wine 11.0 + msync + CW hacks, DXVK 1.10.3, ------
# ---- MoltenVK 1.2.10, vkd3d 1.18, freetype 2.13.3, gnutls 3.8.3, nettle 3.10, gmp 6.3.0)
CX_VERSION=26.3.0
CX_TARBALL=crossover-sources-26.3.0.tar.gz
CX_URL=https://media.codeweavers.com/pub/crossover/source/crossover-sources-26.3.0.tar.gz
# Mirror: our own prerelease (created by main once approved; LGPL source publication).
CX_MIRROR_URL=https://github.com/jmproulx/peakpack/releases/download/mac-build-src-cx26.3.0/crossover-sources-26.3.0.tar.gz
# verified-local: tools/steamwork/crossover_src/crossover-sources-26.3.0.tar.gz (149 MB), 12 Oct 2026
CX_SHA256=ac99c8ca4b3848f3e81784135f023df266b61c2345726ea55a50b3e030dd6872

# ---- nettle 3.10 (GNU release; replaces the CrossOver copy) -----------------
# The CrossOver tarball's sources/gnutls/nettle is a git checkout of 3.10 WITHOUT the
# release files (no top-level Makefile.in, configure, config.h.in): CI run 38302411894
# failed with "config.status: cannot find input file: 'Makefile.in'". Every source file it
# does have is identical to this release (diff -rq: 0 differing files). LGPL-3.0+/GPL-2.0+.
# verified-local 12 Oct 2026: GPG "Good signature" from Niels Moeller
# (343C2FF0FBEE5EC2EDBEF399F3599FF828C67298, via ftp.gnu.org/gnu/gnu-keyring.gpg).
NETTLE_VERSION=3.10
NETTLE_URL=https://ftp.gnu.org/gnu/nettle/nettle-3.10.tar.gz
NETTLE_SHA256=b4c518adb174e484cb4acea54118f02380c7133771e7e9beb98a0787194ee47c

# ---- PE cross toolchain ------------------------------------------------------
LLVM_MINGW_VERSION=20260826
LLVM_MINGW_MAC_URL=https://github.com/mstorsjo/llvm-mingw/releases/download/20260826/llvm-mingw-20260826-ucrt-macos-universal.tar.xz
# gh-digest, and identical to Gcenx/macports-wine cross/llvm-mingw/Portfile (size 124220620)
LLVM_MINGW_MAC_SHA256=48bedd161f14ae25a3646cb750b57ee3188e97e34bd3c52240c1810aa74d6a7f

# ---- MoltenVK (Vulkan->Metal, for winevulkan + DXVK fallback) ----------------
MOLTENVK_VERSION=v1.4.2
MOLTENVK_URL=https://github.com/KhronosGroup/MoltenVK/releases/download/v1.4.2/MoltenVK-macos.tar
# gh-digest (read via API summary 12 Oct 2026; size 59563008). A mismatch fails the build safely.
MOLTENVK_SHA256=f95765a6229cb7b915990a2890ce12ebe36a730b021545d3d52ae69ce4c4024e

# ---- libinotify-kqueue (inotify emulation -> ReadDirectoryChangesW for AutoReload, G-D3)
# MIT. Latest release (2024-07-23). GitHub publishes no digest for this asset.
LIBINOTIFY_VERSION=20240724
LIBINOTIFY_URL=https://github.com/libinotify-kqueue/libinotify-kqueue/releases/download/20240724/libinotify-20240724.tar.gz
# verified-local 12 Oct 2026: SHA-256 of the asset fetched over HTTPS from GitHub (462788 bytes).
LIBINOTIFY_SHA256=5cc3fb7af407b17b7daa871cc98bb882716c4b5c296fadfb66bfe86c37cc599c

# ---- DXMT (D3D11 -> Metal) ---------------------------------------------------
# Default pin: tag v0.80 (2026-04-23, last MIT release). Candidate B (LGPL main,
# post-#220 fix) is a G-A2 tuning axis; see docs/DECISIONS.md D3.
DXMT_REPO=https://github.com/3Shain/dxmt.git
DXMT_TAG=v0.80
# annotated tag object bc48400148cfd3d720200a3f5486a9d564745394 -> commit:
DXMT_COMMIT=589adb780354b461645b29999cefaf533594ee99
# Prebuilt upstream v0.80 (for the G-A1 A/B check against our build only): gh-digest
DXMT_PREBUILT_URL=https://github.com/3Shain/dxmt/releases/download/v0.80/dxmt-v0.80-builtin.tar.gz
DXMT_PREBUILT_SHA256=8f260e36b5739e68f3bad613381441385c4dc7b85b78ba8de653d5a6a264529d
# Toolchain DXMT requires: LLVM exactly 15 (built x86_64-darwin, no targets), meson >= 1.3
LLVM15_VERSION=15.0.7
LLVM15_URL=https://github.com/llvm/llvm-project/releases/download/llvmorg-15.0.7/llvm-project-15.0.7.src.tar.xz
# third-party: Homebrew llvm@15 formula (GitHub publishes no digest for this release; size 110936452)
LLVM15_SHA256=8b5fcb24b4128cf04df1b0b9410ce8b1a729cb3c544e6da885d234280dedeac6
MESON_VERSION=1.10.0
NINJA_PIP_VERSION=1.13.0

# ---- DXVK (fallback) ---------------------------------------------------------
# Built from the CrossOver tarball's sources/dxvk (DXVK 1.10.3 with CodeWeavers'
# macOS/MoltenVK changes), so it is pinned by CX_SHA256. Built on Linux with
# mingw-w64 GCC, exactly as CodeWeavers' own cxlab CI does.
DXVK_FROM=crossover

# ---- Optional baseline (G-A1 quick start only; not part of our build) -------
WHISKY_LIBS_VERSION=3.1.1
WHISKY_LIBS_URL=https://github.com/frankea/Whisky/releases/download/v3.1.1/Libraries.tar.gz
# gh-digest matches docs/DEPENDENCIES.md of frankea/Whisky (size 332438526)
WHISKY_LIBS_SHA256=01f3a1b43b98065fe20c529c1023b61dd79a6d2ad93bba6040865f646481ccf3

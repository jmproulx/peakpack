# shellcheck shell=bash disable=SC2034
# PeakPack for Mac, native track: every input of the self-contained converter bundle
# (peakpack-native-tools-<NT_VERSION>-macos-arm64.tar.xz), pinned by URL + SHA-256 or git commit.
# Python packages are pinned in requirements.lock / requirements-build.lock (exact version + sha256).
# There is no "unpinned" mode: build_bundle.sh --check-pins refuses any empty, FILL or malformed pin,
# and the workflow runs that check before building and again before publishing.
#
# Provenance: "gh-digest" = GitHub release-asset digest (api.github.com ... assets[].digest);
# "sums" = the release's own SHA256SUMS file; "verified-local" = hashed on Joshua's PC.

# ---- Our revision -----------------------------------------------------------
NT_VERSION=0.2.0              # bump on any change to this file, the locks, build_bundle.sh or the converter
NT_PUBLISH_ALLOWED=0          # 1 = the workflow may create the prerelease (publish=true). Kept 0 until
                              # the lead approves the first bundle after G-C0 phase (b).
NT_MACOS_MIN=11.0             # floor of every Mach-O we ship (python-build-standalone and the wheels are 11.0)

# ---- python-build-standalone (CPython, PSF licence + bundled third-party libs) ----
# Release 20261009 (2026-10-09, not a prerelease; tag commit ccc07c40c2731bfb459c119f2388f65a5a470de6).
# The converter needs Python 3.11+ (native/README.md); 3.13 matches the PC venv (3.13.14) it is tested on.
PBS_RELEASE=20261009
PBS_PYTHON_VERSION=3.13.16
PBS_ASSET=cpython-3.13.16+20261009-aarch64-apple-darwin-install_only.tar.gz
PBS_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20261009/cpython-3.13.16%2B20261009-aarch64-apple-darwin-install_only.tar.gz
# sums + gh-digest (identical) + verified-local (12 Oct 2026), 25378093 bytes.
# SHA256SUMS kept at tools/nativetools-pins/pbs/ on the PC.
PBS_SHA256=3338fcd572a670ec45ac9ef75480b95595ea9b6b5dd320952fcf5df185089941
# The install_only archive carries only CPython's LICENSE.txt; the licence texts of the libraries
# python-build-standalone links in (OpenSSL, libffi, SQLite, xz, zlib, bzip2, mpdecimal, ncurses, libedit,
# ...) are in the matching "full" archive (same build, pgo+lto). Only python/licenses/ and python/PYTHON.json
# are extracted from it; nothing else from it ships. sums + gh-digest (identical), 59336019 bytes.
PBS_FULL_ASSET=cpython-3.13.16+20261009-aarch64-apple-darwin-pgo+lto-full.tar.zst
PBS_FULL_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20261009/cpython-3.13.16%2B20261009-aarch64-apple-darwin-pgo%2Blto-full.tar.zst
PBS_FULL_SHA256=70025edd2ed4bf0a333677928ded047368726954253b6e428732e71e9c5a163e

# ---- SPIRV-Cross (Apache-2.0) --------------------------------------------------
# Same sources as the PC build (tools/spirv-cross/SPIRV-Cross-vulkan-sdk-1.4.363.0.zip: the GitHub archive's
# zip comment is this commit). The tag is lightweight; the build fetches the COMMIT and checks the tag agrees.
SPIRV_CROSS_REPO=https://github.com/KhronosGroup/SPIRV-Cross.git
SPIRV_CROSS_TAG=vulkan-sdk-1.4.363.0
SPIRV_CROSS_COMMIT=f11ba9f0b21ba8fc15153d50a2a1ae31ab1cf8f7

# ---- Package index ---------------------------------------------------------------
PYPI_INDEX_URL=https://pypi.org/simple

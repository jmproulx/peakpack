# Scripts, patches, registry files and CI must keep LF (they run on macOS / Linux / Wine).
*.sh      text eol=lf
*.patch   text eol=lf
*.reg     text eol=lf
*.yml     text eol=lf
*.env     text eol=lf
*.py      text eol=lf
*.conf    text eol=lf
*.spec    text eol=lf
*.def     text eol=lf
*.c       text eol=lf
*.h       text eol=lf
series    text eol=lf
*.exe     binary
*.dll     binary
*.json    text eol=lf
*.md      text eol=lf
*.awk     text eol=lf
*.manifest text eol=lf
*.lock    text eol=lf
